rules_version = '2';

// Paste this into Firebase Console → Firestore Database → Rules.
// Each signed-in user can only read/write their own data under users/{uid}/ —
// nobody else's, and nothing unauthenticated. That covers one document per
// record in users/{uid}/sessions/{id}, users/{uid}/routines/{id}, … and the
// old single-document log at users/{uid}/data/log (kept as a backup).
//
// Firebase's own default (before you publish anything) is deny-all:
//   match /{document=**} { allow read, write: if false; }
// Make sure the console shows ONLY the block below, not both stacked.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{collection}/{document} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
